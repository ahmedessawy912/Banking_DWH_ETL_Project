    <DTS:Executable
      DTS:refId="Package\Generate DimDate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DC59FB1C-0E89-468E-8728-E51DBF047BB0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Generate DimDate"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{07B407D3-C2E7-40E6-A96D-AEE84AD2FE68}"
          SQLTask:SqlStatementSource="WITH DateRange AS&#xA;(&#xA;    SELECT CAST('2000-01-01' AS DATE) AS DateValue&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT DATEADD(DAY, 1, DateValue)&#xA;    FROM DateRange&#xA;    WHERE DateValue &lt; '2030-12-31'&#xA;)&#xA;INSERT INTO [dbo].[DimDate]&#xA;(&#xA;    DateSK,&#xA;    [Date],&#xA;    [Day],&#xA;    DaySuffix,&#xA;    DayOfWeek,&#xA;    DOWInMonth,&#xA;    DayOfYear,&#xA;    WeekOfYear,&#xA;    WeekOfMonth,&#xA;    [Month],&#xA;    MonthName,&#xA;    [Quarter],&#xA;    QuarterName,&#xA;    [Year],&#xA;    StandardDate,&#xA;    HolidayText&#xA;)&#xA;SELECT&#xA;    YEAR(DateValue) * 10000&#xA;        + MONTH(DateValue) * 100&#xA;        + DAY(DateValue)                    AS DateSK,&#xA;&#xA;    DateValue                               AS [Date],&#xA;&#xA;    RIGHT('0' + CAST(DAY(DateValue) AS VARCHAR(2)), 2)&#xA;                                             AS [Day],&#xA;&#xA;    CASE&#xA;        WHEN DAY(DateValue) IN (11, 12, 13) THEN 'th'&#xA;        WHEN DAY(DateValue) % 10 = 1 THEN 'st'&#xA;        WHEN DAY(DateValue) % 10 = 2 THEN 'nd'&#xA;        WHEN DAY(DateValue) % 10 = 3 THEN 'rd'&#xA;        ELSE 'th'&#xA;    END                                      AS DaySuffix,&#xA;&#xA;    DATENAME(WEEKDAY, DateValue)             AS DayOfWeek,&#xA;&#xA;    ((DAY(DateValue) - 1) / 7) + 1           AS DOWInMonth,&#xA;&#xA;    DATEPART(DAYOFYEAR, DateValue)            AS DayOfYear,&#xA;&#xA;    DATEPART(WEEK, DateValue)                 AS WeekOfYear,&#xA;&#xA;    ((DAY(DateValue) - 1) / 7) + 1           AS WeekOfMonth,&#xA;&#xA;    RIGHT('0' + CAST(MONTH(DateValue) AS VARCHAR(2)), 2)&#xA;                                             AS [Month],&#xA;&#xA;    DATENAME(MONTH, DateValue)                AS MonthName,&#xA;&#xA;    DATEPART(QUARTER, DateValue)              AS [Quarter],&#xA;&#xA;    'Q' + CAST(DATEPART(QUARTER, DateValue) AS VARCHAR(1))&#xA;                                             AS QuarterName,&#xA;&#xA;    CAST(YEAR(DateValue) AS CHAR(4))          AS [Year],&#xA;&#xA;    CONVERT(VARCHAR(10), DateValue, 23)       AS StandardDate,&#xA;&#xA;    NULL                                      AS HolidayText&#xA;&#xA;FROM DateRange&#xA;OPTION (MAXRECURSION 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
